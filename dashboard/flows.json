    {
        "id": "8fb570c35e38ad70",
        "type": "function",
        "z": "f2167687c85f59b3",
        "name": "event log (rolling 15)",
        "func": "// In: parsed payload of <UNS_BASE>/State/event\n// Keeps a rolling buffer of the last 15 events in flow context 'eventRows'.\nconst p = msg.payload || {};\nconst ts = new Date().toISOString().replace(\"T\", \" \").slice(0, 19);\nconst row = {\n    ts: ts,\n    event: p.event || \"\",\n    condition: p.condition_id || \"\",\n    severity: p.severity || \"\",\n    dur_s: (p.duration_s === undefined || p.duration_s === null) ? \"\" : p.duration_s,\n    summary: p.summary || \"\"\n};\nlet rows = flow.get(\"eventRows\") || [];\nrows.unshift(row);\nif (rows.length > 15) { rows = rows.slice(0, 15); }\nflow.set(\"eventRows\", rows);\nreturn { payload: rows };\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 700,
        "y": 160,
        "wires": [
            [
                "a35faaf77376897e"
            ]

        "name": "build label action",
        "func": "// Builds the Action/feedback payload for action=label\n// (answers an open 'unknown' episode; label slug + 'by' come from dashboard inputs)\nconst slug = String(flow.get(\"labelSlug\") || \"\").trim();\nconst by = flow.get(\"labelBy\") || \"human\";\nreturn { payload: { action: \"label\", label: slug || \"unknown_condition\", by: by } };\n",

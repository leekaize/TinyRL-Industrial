    {
        "id": "c0bb28d1ee0c25ce",
        "type": "function",
        "z": "f2167687c85f59b3",
        "name": "condition state + banner",
        "func": "// In: parsed payload of <UNS_BASE>/State/condition\n//     OR {\"payload\":\"heartbeat\"} from the 5 s repeater (keeps the age counter ticking)\n// Contract note: State/condition is change-driven + retained, so a quiet node is HEALTHY.\n// Age is informational only - no stale alarm.\nlet cur = flow.get(\"cond\") || null;\nif (msg.payload === \"heartbeat\") {\n    if (!cur) { return [null, null]; }        // waiting for first update\n    cur.age_s = Math.round((Date.now() - cur.ts) / 1000);\n} else {\n    const p = msg.payload || {};\n    cur = {\n        state: p.state || \"unknown_state\",\n        condition_id: p.condition_id || \"-\",\n        confidence: (typeof p.confidence === \"number\") ? p.confidence : 0,\n        episode_s: (typeof p.episode_s === \"number\") ? p.episode_s : 0,\n        ts: Date.now(),\n        age_s: 0\n    };\n}\nflow.set(\"cond\", cur);\n\n// Banner classification (ISA-101: grey when healthy, colour only for abnormal)\nlet k, line1, line2;\nif (cur.state === \"alarm\" && cur.condition_id === \"unknown\") {\n    k = \"alarm\";\n    line1 = \"ALARM\";\n    line2 = \"UNLABELED CONDITION - answer with LABEL (confidence \" +\n        Math.round(cur.confidence * 100) + \"%, episode \" + cur.episode_s + \" s)\";\n} else if (cur.state === \"alarm\") {\n    k = \"alarm\";\n    line1 = \"ALARM\";\n    line2 = (cur.condition_id || \"?\") + \" - confidence \" + Math.round(cur.confidence * 100) +\n        \"% - episode \" + cur.episode_s + \" s\";\n} else if (cur.condition_id === \"unknown\") {\n    k = \"attention\";\n    line1 = \"UNLABELED CONDITION\";\n    line2 = \"open ask - answer with LABEL (confidence \" + Math.round(cur.confidence * 100) + \"%)\";\n} else if (cur.state === \"learn\") {\n    k = \"info\"; line1 = \"LEARNING\"; line2 = \"capturing normal-behaviour statistics\";\n} else if (cur.state === \"idle\") {\n    k = \"info\"; line1 = \"IDLE\"; line2 = \"send START to begin learning\";\n} else if (cur.state === \"ok\") {\n    k = \"info\"; line1 = \"OK\"; line2 = \"monitoring - last update \" + cur.age_s + \" s ago\";\n} else {\n    k = \"info\"; line1 = cur.state.toUpperCase(); line2 = \" \";\n}\n\nconst out1 = { payload: {\n    k: k, line1: line1, line2: line2,\n    state: cur.state, condition_id: cur.condition_id,\n    confidence: cur.confidence, episode_s: cur.episode_s, age_s: cur.age_s\n} };\n// out2: numeric confidence for the trend - real condition messages only (not heartbeats)\nconst out2 = (msg.payload === \"heartbeat\") ? null : { payload: cur.confidence, topic: \"confidence\" };\nreturn [out1, out2];\n",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 710,
        "y": 100,
